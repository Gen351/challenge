# Global rules for binaries and large assets
*.csv
*.exe
*.jpg
*.png
*.zip
*.cnn
*.txt

# Ignore specific heavy data files
mnist_train.csv
mnist_test.csv
fashion-mnist_train.csv
fashion-mnist_test.csv

# Ignore everything inside cnn-data
cnn-data/**/*

# BUT allow the folders to exist
# AND specifically allow the flowers folder content
!cnn-data/flowers/
!cnn-data/flowers/flowers_dataset.csv

# Ignore all models inside subfolders
trained_cnns/**/*.cnn

# Ignore VS Code settings
.vscode/